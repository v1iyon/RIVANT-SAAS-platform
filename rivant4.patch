diff --git a/tests/margin.test.js b/tests/margin.test.js
new file mode 100644
index 0000000..147d5a7
--- /dev/null
+++ b/tests/margin.test.js
@@ -0,0 +1,73 @@
+// tests/margin.test.js
+//
+// getFullMarginForDay існує тому, що 4 різні поверхні (кабінет, бот,
+// прогноз, дайджест) раніше рахували маржу по-різному й показували РІЗНІ
+// цифри за той самий день (див. коментар на початку lib/margin.js). Ці
+// тести фіксують формулу, щоб майбутня правка одного місця не розійшлася
+// знову з іншими трьома.
+//
+// lib/margin.js створює supabase-admin клієнт через require() одразу при
+// завантаженні модуля — vi.mock("@supabase/supabase-js") НЕ перехоплює цей
+// виклик надійно (require() у CJS-файлі йде повз ESM-граф модулів, яким
+// керує vi.mock). Замість цього підміняємо глобальний fetch — supabase-js
+// v2 сам усередині робить звичайний fetch() до REST API, тож підмінений
+// fetch дає повний контроль над відповіддю без внутрішнього мокання
+// бібліотеки.
+process.env.NEXT_PUBLIC_SUPABASE_URL ||= "https://test.supabase.co";
+process.env.SUPABASE_SERVICE_KEY ||= "test-service-key";
+
+import { describe, it, expect, vi, beforeEach } from "vitest";
+
+let mockExpenseRows = [];
+let mockStatus = 200;
+
+beforeEach(() => {
+  vi.stubGlobal(
+    "fetch",
+    vi.fn(async () => new Response(JSON.stringify(mockExpenseRows), { status: mockStatus, headers: { "content-type": "application/json" } }))
+  );
+});
+
+const { getFullMarginForDay } = await import("../lib/margin.js");
+
+describe("getFullMarginForDay", () => {
+  it("додає expenses поверх baseCost із metrics_computed", async () => {
+    mockExpenseRows = [{ amount: 50 }, { amount: 30 }];
+    mockStatus = 200;
+    const { fullCost, marginPct } = await getFullMarginForDay("biz1", "2026-09-01", 1000, 400);
+    expect(fullCost).toBe(480); // 400 (baseCost) + 50 + 30 (expenses)
+    expect(marginPct).toBe(52); // (1000 - 480) / 1000 * 100
+  });
+
+  it("якщо additional expenses немає — маржа рахується лише від baseCost, без падіння в NaN/undefined", async () => {
+    mockExpenseRows = [];
+    mockStatus = 200;
+    const { fullCost, marginPct } = await getFullMarginForDay("biz1", "2026-09-01", 1000, 400);
+    expect(fullCost).toBe(400);
+    expect(marginPct).toBe(60);
+  });
+
+  it("revenue = 0 -> marginPct = 0, а не Infinity/NaN від ділення на нуль", async () => {
+    mockExpenseRows = [];
+    mockStatus = 200;
+    const { marginPct } = await getFullMarginForDay("biz1", "2026-09-01", 0, 0);
+    expect(marginPct).toBe(0);
+    expect(Number.isFinite(marginPct)).toBe(true);
+  });
+
+  it("помилка читання expenses не кидає виняток — деградує до маржі без expenses, а не валить викликача (бот/дайджест/прогноз)", async () => {
+    mockExpenseRows = [];
+    mockStatus = 500; // PostgREST-подібна помилка сервера
+    const { fullCost, marginPct } = await getFullMarginForDay("biz1", "2026-09-01", 1000, 400);
+    expect(fullCost).toBe(400);
+    expect(marginPct).toBe(60);
+  });
+
+  it("округлює marginPct до 1 знаку, а fullCost до 2 — консистентно з тим, що показується в UI", async () => {
+    mockExpenseRows = [{ amount: 33.333 }];
+    mockStatus = 200;
+    const { fullCost, marginPct } = await getFullMarginForDay("biz1", "2026-09-01", 700, 100);
+    expect(fullCost).toBe(133.33);
+    expect(marginPct).toBe(81); // (700 - 133.33) / 700 * 100 = 80.9528... -> toFixed(1) округлює до 81.0 -> 81
+  });
+});
diff --git a/tests/mfa-backup-codes.test.js b/tests/mfa-backup-codes.test.js
new file mode 100644
index 0000000..959959c
--- /dev/null
+++ b/tests/mfa-backup-codes.test.js
@@ -0,0 +1,65 @@
+// tests/mfa-backup-codes.test.js
+import { describe, it, expect, beforeAll } from "vitest";
+import { generateBackupCodes, hashBackupCode } from "../lib/mfa-backup-codes.js";
+
+beforeAll(() => {
+  // hashBackupCode/generateBackupCodes навмисно кидають виняток без
+  // ENCRYPTION_KEY (див. коментар у самому файлі) — у реальному оточенні
+  // це завжди задано, тут підставляємо тестове значення.
+  process.env.ENCRYPTION_KEY = "test-encryption-key-for-unit-tests-only";
+});
+
+describe("generateBackupCodes", () => {
+  it("генерує 10 кодів за замовчуванням", () => {
+    const { plainCodes, hashes } = generateBackupCodes();
+    expect(plainCodes).toHaveLength(10);
+    expect(hashes).toHaveLength(10);
+  });
+
+  it("кожен код унікальний у межах однієї партії (немає видимих колізій)", () => {
+    const { plainCodes } = generateBackupCodes(50); // більша партія навмисно, щоб колізія була помітнішою, якби існувала
+    expect(new Set(plainCodes).size).toBe(plainCodes.length);
+  });
+
+  it("формат коду — XXXXX-XXXXX, без заплутуваних символів 0/O/1/I", () => {
+    const { plainCodes } = generateBackupCodes(20);
+    for (const code of plainCodes) {
+      expect(code).toMatch(/^[A-Z2-9]{5}-[A-Z2-9]{5}$/);
+      expect(code).not.toMatch(/[01OI]/);
+    }
+  });
+
+  it("hashes відповідають саме hashBackupCode(plainCode) — консистентність generate() і окремого виклику hash", () => {
+    const { plainCodes, hashes } = generateBackupCodes(5);
+    plainCodes.forEach((code, i) => {
+      expect(hashBackupCode(code)).toBe(hashes[i]);
+    });
+  });
+});
+
+describe("hashBackupCode", () => {
+  it("детермінований — однаковий код завжди дає однаковий хеш", () => {
+    expect(hashBackupCode("ABCDE-FGHJK")).toBe(hashBackupCode("ABCDE-FGHJK"));
+  });
+
+  it("регістр і дефіс не впливають на результат — так само зійдеться, якщо ввести код без дефісу чи малими літерами", () => {
+    const a = hashBackupCode("ABCDE-FGHJK");
+    const b = hashBackupCode("abcde-fghjk");
+    const c = hashBackupCode("ABCDEFGHJK");
+    const d = hashBackupCode("  ABCDE-FGHJK  ");
+    expect(a).toBe(b);
+    expect(a).toBe(c);
+    expect(a).toBe(d);
+  });
+
+  it("різні коди дають різні хеші", () => {
+    expect(hashBackupCode("ABCDE-FGHJK")).not.toBe(hashBackupCode("ABCDE-FGHJ2"));
+  });
+
+  it("кидає виняток без ENCRYPTION_KEY, а не тихо хешує передбачуваним фолбеком", () => {
+    const saved = process.env.ENCRYPTION_KEY;
+    delete process.env.ENCRYPTION_KEY;
+    expect(() => hashBackupCode("ABCDE-FGHJK")).toThrow();
+    process.env.ENCRYPTION_KEY = saved;
+  });
+});
diff --git a/tests/quickbooks-categorize.test.js b/tests/quickbooks-categorize.test.js
new file mode 100644
index 0000000..3e5764f
--- /dev/null
+++ b/tests/quickbooks-categorize.test.js
@@ -0,0 +1,49 @@
+// tests/quickbooks-categorize.test.js
+//
+// scripts/quickbooks-sync.mjs (і lib/alerts.mjs, яку воно імпортує)
+// створює supabase-admin клієнт одразу при завантаженні модуля — без
+// валідного NEXT_PUBLIC_SUPABASE_URL createClient() кидає "supabaseUrl is
+// required." ще ДО того, як ми дістанемось до самої функції категоризації.
+// Ставимо валідні за форматом (але фейкові) значення — конструктор клієнта
+// це задовольняє і мережевих запитів не робить сам по собі; жоден мережевий
+// виклик у цьому тесті й не відбувається, бо categorizeQuickbooksAccount —
+// чиста функція без звернень до БД.
+process.env.NEXT_PUBLIC_SUPABASE_URL ||= "https://test.supabase.co";
+process.env.SUPABASE_SERVICE_KEY ||= "test-service-key";
+
+import { describe, it, expect } from "vitest";
+
+const { categorizeQuickbooksAccount } = await import("../scripts/quickbooks-sync.mjs");
+
+describe("categorizeQuickbooksAccount", () => {
+  it("розпізнає рекламні рахунки", () => {
+    expect(categorizeQuickbooksAccount("Advertising")).toBe("advertising");
+    expect(categorizeQuickbooksAccount("Facebook Ads")).toBe("advertising");
+    expect(categorizeQuickbooksAccount("Marketing & Promotion")).toBe("advertising");
+  });
+
+  it("розпізнає доставку", () => {
+    expect(categorizeQuickbooksAccount("Shipping")).toBe("shipping");
+    expect(categorizeQuickbooksAccount("Postage and Delivery")).toBe("shipping");
+    expect(categorizeQuickbooksAccount("Freight Costs")).toBe("shipping");
+  });
+
+  it("розпізнає собівартість — саме ту категорію, яку код навмисно перевіряє РАНІШЕ за інші (див. коментар у файлі)", () => {
+    expect(categorizeQuickbooksAccount("Cost of Goods Sold")).toBe("cost_of_goods");
+    expect(categorizeQuickbooksAccount("COGS")).toBe("cost_of_goods");
+    expect(categorizeQuickbooksAccount("Inventory Purchases")).toBe("cost_of_goods");
+  });
+
+  it("нетипову/невідому назву рахунку відносить в other, а не падає й не вгадує", () => {
+    expect(categorizeQuickbooksAccount("Office Rent")).toBe("other");
+    expect(categorizeQuickbooksAccount("Bank Fees")).toBe("other");
+    expect(categorizeQuickbooksAccount("")).toBe("other");
+    expect(categorizeQuickbooksAccount(undefined)).toBe("other");
+    expect(categorizeQuickbooksAccount(null)).toBe("other");
+  });
+
+  it("не залежить від регістру назви рахунку", () => {
+    expect(categorizeQuickbooksAccount("ADVERTISING")).toBe("advertising");
+    expect(categorizeQuickbooksAccount("shipping")).toBe("shipping");
+  });
+});
diff --git a/tests/revenue-mode.test.js b/tests/revenue-mode.test.js
new file mode 100644
index 0000000..328939f
--- /dev/null
+++ b/tests/revenue-mode.test.js
@@ -0,0 +1,100 @@
+// tests/revenue-mode.test.js
+//
+// lib/revenue-mode.js існує ЛИШЕ тому, що конфлікт двох "replace"-провайдерів
+// одного разу вже тихо губив дохід (див. коментар на початку самого файлу).
+// Ці тести фіксують саме той сценарій — щоб майбутня правка цієї логіки не
+// повторила ту саму помилку непомітно.
+import { describe, it, expect, vi } from "vitest";
+import { effectiveRevenueMode, downgradeConflictingReplaceProviders, REPLACE_TOGGLE_PROVIDERS } from "../lib/revenue-mode.js";
+
+describe("effectiveRevenueMode", () => {
+  it("дефолтить на replace, якщо revenue_mode взагалі не заданий", () => {
+    expect(effectiveRevenueMode(undefined)).toBe("replace");
+    expect(effectiveRevenueMode({})).toBe("replace");
+  });
+
+  it("дефолтить на replace для будь-якого значення, крім рядка add", () => {
+    expect(effectiveRevenueMode({ revenue_mode: "REPLACE" })).toBe("replace"); // регістр важливий, не нормалізується — це свідома поведінка коду
+    expect(effectiveRevenueMode({ revenue_mode: "unknown" })).toBe("replace");
+    expect(effectiveRevenueMode({ revenue_mode: null })).toBe("replace");
+  });
+
+  it("повертає add лише коли revenue_mode точно дорівнює add", () => {
+    expect(effectiveRevenueMode({ revenue_mode: "add" })).toBe("add");
+  });
+});
+
+// Мінімальний mock supabase-js chain (.from().select().eq().in() / .update().eq()),
+// достатній саме для того, як downgradeConflictingReplaceProviders його викликає.
+function makeAdminMock({ rows = [], selectError = null, updateError = null } = {}) {
+  const updateCalls = [];
+  const admin = {
+    from: () => ({
+      select: () => ({
+        eq: () => ({
+          in: () => Promise.resolve({ data: rows, error: selectError }),
+        }),
+      }),
+      update: (payload) => ({
+        eq: (_col, id) => {
+          updateCalls.push({ id, payload });
+          return Promise.resolve({ error: updateError });
+        },
+      }),
+    }),
+  };
+  return { admin, updateCalls };
+}
+
+describe("downgradeConflictingReplaceProviders", () => {
+  it("нічого не робить, якщо requestedMode не replace (переходити в add ні з ким конфліктувати)", async () => {
+    const { admin, updateCalls } = makeAdminMock({ rows: [{ id: "1", provider: "shopify", config: { revenue_mode: "replace" } }] });
+    const result = await downgradeConflictingReplaceProviders(admin, "biz1", "woocommerce", "add");
+    expect(result).toEqual([]);
+    expect(updateCalls).toHaveLength(0);
+  });
+
+  it("понижує ІНШОГО replace-провайдера до add, коли поточний переходить у replace — саме той баг, що описаний у коментарі файлу", async () => {
+    const { admin, updateCalls } = makeAdminMock({
+      rows: [{ id: "shop-row-id", provider: "shopify", config: { revenue_mode: "replace" } }],
+    });
+    const downgraded = await downgradeConflictingReplaceProviders(admin, "biz1", "woocommerce", "replace");
+    expect(downgraded).toEqual(["shopify"]);
+    expect(updateCalls).toHaveLength(1);
+    expect(updateCalls[0].payload.config.revenue_mode).toBe("add");
+  });
+
+  it("не чіпає провайдера, який вже й так в add", async () => {
+    const { admin, updateCalls } = makeAdminMock({
+      rows: [{ id: "woo-row-id", provider: "woocommerce", config: { revenue_mode: "add" } }],
+    });
+    const downgraded = await downgradeConflictingReplaceProviders(admin, "biz1", "shopify", "replace");
+    expect(downgraded).toEqual([]);
+    expect(updateCalls).toHaveLength(0);
+  });
+
+  it("виключає САМ провайдер, що переходить у replace, зі списку кандидатів на конфлікт", async () => {
+    let queriedProviders = null;
+    const admin = {
+      from: () => ({
+        select: () => ({
+          eq: () => ({
+            in: (_col, providers) => {
+              queriedProviders = providers;
+              return Promise.resolve({ data: [], error: null });
+            },
+          }),
+        }),
+      }),
+    };
+    await downgradeConflictingReplaceProviders(admin, "biz1", "shopify", "replace");
+    expect(queriedProviders).not.toContain("shopify");
+    expect(queriedProviders.sort()).toEqual(REPLACE_TOGGLE_PROVIDERS.filter((p) => p !== "shopify").sort());
+  });
+
+  it("не падає, якщо запит на читання integrations впав — повертає порожній масив, а не кидає виняток", async () => {
+    const { admin } = makeAdminMock({ selectError: { message: "boom" } });
+    const result = await downgradeConflictingReplaceProviders(admin, "biz1", "shopify", "replace");
+    expect(result).toEqual([]);
+  });
+});
