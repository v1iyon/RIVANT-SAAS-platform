diff --git a/.github/workflows/sync-stripe.yml b/.github/workflows/sync-stripe.yml
index e4ee0be..d03db43 100644
--- a/.github/workflows/sync-stripe.yml
+++ b/.github/workflows/sync-stripe.yml
@@ -18,6 +18,18 @@ name: Sync integrations (Stripe, Shopify, Meta Ads, Google Ads)
 # уведомление на неудачный запуск.
 on:
   workflow_dispatch: {}
+  # ФІКС (аудит, п.11 риск №5): раніше єдиним джерелом розкладу був
+  # зовнішній безкоштовний cron-job.org — якщо він зупиниться (протух
+  # токен, впав ліміт тощо), синк тихо перестав би йти, і жодних слідів
+  # цього не було б ні в репозиторії, ні в GitHub Actions. Нативний
+  # `schedule:` тут — це НЕ заміна cron-job.org (той лишається основним
+  # джерелом кожні 15 хв, бо GitHub-крон для публічних/безкоштовних
+  # розкладів сам по собі не гарантує точний час — може запізнюватись на
+  # 5-15+ хв у пікові години), а резервна лінія: якщо cron-job.org
+  # замовкне, синк все одно продовжить йти раз на годину замість "ніколи",
+  # поки хтось не помітить і не полагодить основний розклад.
+  schedule:
+    - cron: "23 * * * *" # раз на годину, у невікенду GitHub-хвилину — навмисно НЕ 0/15/30/45
 
 jobs:
   sync:
